# Config file to run RIVA Transactional mode with any combination of services.
# Preferable to use:
# RIVA Canary NIM for AST
# RIVA Magpie Zeroshot NIM for TTS
# Can run fully in streaming mode.
NVIDIA_VISIBLE_DEVICES=all

# Shared Timeouts (used by both Controller and S2S services)
HEALTH_CHECK_TIMEOUT=5.0
BUFFER_POLL_TIMEOUT=0.1

# S2S Defaults
S2S_SERVICE="RIVA_TRANSACTIONAL" 
S2S_GRPC_API_PORT=50050
S2S_MAX_CONCURRENCY=1
S2S_LOG_LEVEL="INFO"
S2S_DEFAULT_SOURCE_LANGUAGE=es-US
S2S_DEFAULT_TARGET_LANGUAGE=en-US
S2S_SAMPLE_RATE_HZ=16000
S2S_MESSAGE_SIZE=67108864
S2S_GRPC_CONCURRENCY_MODE=threading
S2S_GRPC_THREADS_PER_PROCESS=1
S2S_CLEANUP_TIMEOUT=1.0
S2S_EL_DUBBING_POLL_INTERVAL=10
S2S_EL_DUBBING_MAX_ATTEMPTS=120
S2S_EL_KEEPALIVE_INTERVAL=1

# AST Defaults
AST_NIM_GRPC_API_PORT=50051
AST_NIM_HTTP_API_PORT=8003
AST_NIM_TAGS_SELECTOR="name=canary-1b,mode=ofl"
AST_IMAGE=nvcr.io/nim/nvidia/riva-asr:latest
AST_MODEL_MOUNT_PATH=./volumes/models/ast-canary

# TTS Defaults
# NOTE: If using the RIVA Magpie Multilingual TTS model (magpie-tts-multilingual),
# only en-US is supported as an output (target) language.
TTS_NIM_MODEL=magpie-tts-zeroshot
TTS_IMAGE=nvcr.io/nim/nvidia/${TTS_NIM_MODEL}:latest
TTS_NIM_TAGS_SELECTOR="name=${TTS_NIM_MODEL}"
TTS_NIM_HTTP_API_PORT=9003
TTS_NIM_GRPC_API_PORT=50053
TTS_MODEL_MOUNT_PATH=./volumes/models/tts-zeroshot

# LipSync Defaults
LIP_SYNC_IMAGE=nvcr.io/nim/nvidia/lipsync:1.2.0
LIPSYNC_NIM_HTTP_API_PORT=8004
LIPSYNC_NIM_GRPC_API_PORT=50054
LIPSYNC_LOG_LEVEL="INFO"
LIPSYNC_DEBUG_MODE=0
LIPSYNC_MODEL_MOUNT_PATH=./volumes/models/lipsync

# ASD NIM (Active Speaker Detection)
ASD_IMAGE=nvcr.io/nim/nvidia/active-speaker-detection:1.0.0
ASD_GRPC_API_PORT=50055
ASD_NIM_HTTP_API_PORT=8005
ASD_LOG_LEVEL="INFO"
ASD_MODEL_MOUNT_PATH=./volumes/models/asd
ASD_DIARIZATION_TOLERANCE_MS=0

# Controller Service
CONTROLLER_GRPC_API_PORT=50056
CONTROLLER_MAX_CONCURRENCY=1
CONTROLLER_GRPC_THREADS_PER_PROCESS=1
CONTROLLER_LOG_LEVEL="INFO"
CONTROLLER_GRPC_CONCURRENCY_MODE=threading

# Controller DEBUG Port
CONTROLLER_DEBUG_PORT=5678
CONTROLLER_VS_CODE_DEBUG=0

# Controller Service Options
CONTROLLER_CONFIG_POLL_TIMEOUT=5.0
CONTROLLER_CLEANUP_TIMEOUT=10.0

# Reference App
REFERENCE_APP_LOG_LEVEL="INFO"
DEFAULT_INPUT_FILE_NAME="sample_video.mp4"
# Advanced Settings (diarization, voice isolation) hidden for RIVA.
REFERENCE_APP_ENABLE_PREPROCESSING=false